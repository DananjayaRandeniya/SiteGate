{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/worker-service/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/worker-service/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/worker-service",
  "projects": {
    "access-service": {
      "type": "application",
      "root": "apps/access-service",
      "entryFile": "main",
      "sourceRoot": "apps/access-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/access-service/tsconfig.app.json"
      }
    },
    "audit-alert-service": {
      "type": "application",
      "root": "apps/audit-alert-service",
      "entryFile": "main",
      "sourceRoot": "apps/audit-alert-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/audit-alert-service/tsconfig.app.json",
        "plugins": ["@nestjs/swagger"]
      }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    },
    "worker-service": {
      "type": "application",
      "root": "apps/worker-service",
      "entryFile": "main",
      "sourceRoot": "apps/worker-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/worker-service/tsconfig.app.json"
      }
    }
  }
}